<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema.Laika" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/marinho</item>
        <item name="android:colorAccent">@color/azul</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:textColorHighlight">#552A5CB8</item>
        <item name="android:alertDialogTheme">@style/Laika.Dialogo</item>
        <item name="android:scrollbarThumbVertical">@drawable/barra_rolagem</item>
        <item name="android:scrollbarTrackVertical">@null</item>
        <item name="android:scrollbarSize">3dp</item>
    </style>

    <!-- Todas as janelas de diálogo do app com o mesmo desenho dos painéis (cartão arredondado, cores do app). -->
    <style name="Laika.Dialogo" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/fundo_dialogo</item>
        <item name="android:colorBackground">@color/cartao</item>
        <item name="android:colorAccent">@color/azul</item>
        <item name="android:colorPrimary">@color/azul</item>
        <item name="android:textColorPrimary">@color/topo_texto</item>
        <item name="android:textColorSecondary">@color/topo_sub</item>
        <item name="android:textColorAlertDialogListItem">@color/texto_laika</item>
        <item name="android:windowTitleStyle">@style/Laika.Dialogo.Titulo</item>
        <item name="android:buttonBarButtonStyle">@style/Laika.Dialogo.Botao</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:scrollbarThumbVertical">@drawable/barra_rolagem</item>
        <item name="android:scrollbarTrackVertical">@null</item>
        <item name="android:scrollbarSize">3dp</item>
    </style>

    <style name="Laika.Dialogo.Titulo" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/topo_texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Laika.Dialogo.Botao" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/azul</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
