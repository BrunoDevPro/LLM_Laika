<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo das janelas de diálogo (AlertDialog): o mesmo cartão arredondado dos painéis do app, com margem. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp" android:insetRight="20dp" android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/cartao" />
        <corners android:radius="22dp" />
        <stroke android:width="1dp" android:color="@color/borda" />
    </shape>
</inset>
